# FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartcivic?retryWrites=true&w=majority
DATABASE_NAME=smartcivic

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=72

# Default Government Official (Admin) Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@smartcivic.gov
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=Municipal Official

